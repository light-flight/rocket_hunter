# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# public/ also receives the built React app (frontend/: npm run build:rails).
# Only Rails' own static files are tracked. New static files belong in frontend/public/:
# a file added here by hand is ignored by git and deleted by the next build unless it
# is added to the list below.
/public/*
!/public/400.html
!/public/404.html
!/public/406-unsupported-browser.html
!/public/422.html
!/public/500.html
!/public/icon.png
!/public/icon.svg
!/public/robots.txt

# Ignore key files for decrypting credentials and more.
/config/*.key

